<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BackDoor</title>

    <link rel = "stylesheet" href="/generalStyle.css">
    <link rel = "stylesheet" href="/game-page.css">
    <script src="/game-page.js" defer></script>

    <link rel="stylesheet"href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>

</head>

<%- include('partials/navbar') %>

<body>
    
    <main class = "catalog-main">

        <div class = "catalog-container">

            <h1><%= game.nameAsString %></h1>

            <section class = "catalog-upload-form-container">

                <form id="upload-form">

                    <div id = "upload-form-field-container">
                        
                        <div style = "display: flex; justify-content: center; align-items: center; width: 80%">
                            <section style = "flex: 3">
                                <input id = "upload-form-field-search" placeholder="Search for variables here...">
                            </section>
                            <section style = "flex: 1"> 
                                <button id = "change-input-file-btn" type="button">
                                    Change File...
                                </button>
                            </section>
                        </div>

                    </div>

                    <label for="save-file-input" class="drop-zone" id="drop-zone">

                        <section id = "save-file-input-text">
                            <i class="fa-solid fa-upload"></i>
                            <p>Please Upload File Here...</p>
                        </section>

                        <input
                            id="save-file-input"
                            name="saveFile"
                            type="file"
                            accept=".json,.sav,.txt"
                            hidden
                        >

                    </label>

                </form>

            </section>

            <section class = "catalog-download-btn-container">
                <button id = "file-download-btn">Download</button>
            </section>

        </div>

        <div id = "catalog-description-body">
            <div id="catalog-description-text">

                <%- include(game.descriptionPartial) %>

            </div>
        </div>

    </main>

</body>

<%- include('partials/footer') %>

</html>