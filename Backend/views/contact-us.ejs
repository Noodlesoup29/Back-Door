<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BackDoor</title>

    <link rel = "stylesheet" href="generalStyle.css">
    <link rel = "stylesheet" href="contactUsStyle.css">
    <script src="contactUsScript.js" defer></script>

    <link rel="stylesheet"href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>

</head>

<%- include('partials/navbar') %>

<body>
    
    <main class = "contact-main">

        <h1 style = "font-size: 48px; margin-bottom: 1vh;">Contact Us</h1>

        <div class = "contact-container">

            <div class = "contact-container-child">
                
                <form id = "gmail-form" action="/contact/send" method="POST">

                    <p class = "subject-text">Full Name</p>
                    <input class = "subject-style" name = "subject-header" id = "subject-header" type="text" placeholder="Enter your full name here..." required>
                    
                    <br>

                    <p class = "subject-text">Email Address</p>
                    <input class = "subject-style" name = "subject-email" id = "subject-email" type="text" placeholder="Enter your email address here..." required>
                    
                    <br>

                    <p class = "subject-text">Subject Body</p>
                    <textarea class = "subject-style" name = "subject-body" id = "subject-body" type="text" placeholder="Enter your message here..." required></textarea>
                    
                    <br>

                    <section style = "display: flex; justify-content: space-between; align-items: center; width: 80%">
                        <button name = "subject-submit" id = "subject-submit">Submit</button>
                        <p id = "subject-submit-text" style = "font-weight: bold; text-align: right; font-size: 18px; opacity: 0;">Placeholder</p>
                    </section>

                </form>

            </div>

            <div>
                Hwlloe
            </div>

        </div>

    </main>

</body>

<%- include('partials/footer') %>

</html>